# Copy to .env and fill in. NEVER commit .env.
# Hugging Face token with access to SageBio/mva-hackathon-2026-data
HF_TOKEN=

# Optional: store private data (raw/staging/annotations/features) on another
# disk, e.g. for the ~85 GB full dataset. Empty = project ./data directory.
RAREAI_DATA_DIR=

# Optional: MLflow tracking (Phase 6+)
MLFLOW_TRACKING_URI=

# Optional: LLM provider keys (Phase 8+)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
